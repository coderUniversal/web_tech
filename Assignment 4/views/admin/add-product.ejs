<%- include('../partials/admin-header', { title: 'Add Product' }) %>

<!-- ERROR ALERT -->
<% if (error) { %>
    <div class="alert alert-error">
        ❌ <%= error %>
    </div>
<% } %>

<!-- ADD PRODUCT FORM -->
<div class="form-container">
    <form action="/admin/add" method="POST" enctype="multipart/form-data">

        <!-- NAME -->
        <div class="form-group">
            <label for="name">Product Name</label>
            <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="e.g. Wireless Headphones"
                required
            >
        </div>

        <!-- PRICE -->
        <div class="form-group">
            <label for="price">Price ($)</label>
            <input 
                type="number" 
                id="price" 
                name="price" 
                step="0.01" 
                min="0"
                placeholder="e.g. 49.99"
                required
            >
        </div>

        <!-- CATEGORY -->
        <div class="form-group">
            <label for="category">Category</label>
            <select id="category" name="category" required>
                <option value="">-- Select a Category --</option>
                <option value="Clothing">Clothing</option>
                <option value="Women Items">Women Items</option>
                <option value="Boys">Boys</option>
                <option value="Girls">Girls</option>
                <option value="Kid">Kid</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <!-- RATING -->
        <div class="form-group">
            <label for="rating">Rating (1 - 5)</label>
            <input 
                type="number" 
                id="rating" 
                name="rating" 
                step="0.1" 
                min="1" 
                max="5"
                placeholder="e.g. 4.5"
                required
            >
        </div>

        <!-- STOCK -->
        <div class="form-group">
            <label for="stock">Stock Quantity</label>
            <input 
                type="number" 
                id="stock" 
                name="stock" 
                min="0"
                placeholder="e.g. 100"
                required
            >
        </div>

        <!-- IMAGE UPLOAD -->
        <div class="form-group">
            <label for="image">Product Image</label>
            <div class="file-upload-area">
                <input 
                    type="file" 
                    id="image" 
                    name="image" 
                    accept="image/*"
                    onchange="previewImage(event)"
                >
                <p class="upload-hint">Click to upload an image (max 5MB)</p>
            </div>
        </div>

        <!-- IMAGE PREVIEW -->
        <div class="form-group" id="previewContainer" style="display:none;">
            <label>Image Preview</label>
            <img id="imagePreview" src="#" alt="Preview" class="preview-thumb">
        </div>

        <!-- BUTTONS -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">➕ Add Product</button>
            <a href="/admin" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>

<%- include('../partials/admin-footer') %>