<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thread Theory — Welcome</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css">
</head>
<body>

    <div class="portal-wrapper">

        <div class="portal-card">

            <div class="portal-logo">
                <img src="/images/Gemini_Generated_Image_ol4hvyol4hvyol4h.png" class="rounded-circle" alt="Thread Theory Logo" width="90" height="90">
                <h1>Thread Theory</h1>
                <p>Premium Kids Clothing</p>
            </div>

            <% if (error && error.length > 0) { %>
              <div class="flash-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
            <% } %>
            <% if (success && success.length > 0) { %>
              <div class="flash-success"><i class="bi bi-check-circle"></i> <%= success %></div>
            <% } %>

            <div class="portal-divider">Welcome! How would you like to continue?</div>

            <div class="portal-options">

                <a href="/auth/login" class="portal-btn customer-btn">
                    <i class="bi bi-person-circle"></i>
                    <span>Login as Customer</span>
                    <small>Browse & shop our collection</small>
                </a>

                <a href="/auth/login?role=admin" class="portal-btn admin-btn">
                    <i class="bi bi-shield-lock"></i>
                    <span>Login as Admin</span>
                    <small>Manage products & orders</small>
                </a>

            </div>

            <div class="portal-register">
                New here? <a href="/auth/register">Create an account</a>
            </div>

        </div>

    </div>

    <a href="https://wa.me/923073678124" class="whatsapp-float">
        <i class="bi bi-whatsapp"></i>
    </a>

</body>
</html>